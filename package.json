{
  "name": "tokzip",
  "version": "0.0.0-semantically-released",
  "description": "Lossless compressor for prompts, LLM outputs, and source code stored at rest: one wasm module, automatic language detection, no options",
  "keywords": [
    "cloudflare-workers",
    "compression",
    "llm",
    "prompt",
    "wasm"
  ],
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/tokzip.git"
  },
  "files": [
    "dist/core.d.ts",
    "dist/core.js",
    "dist/core.js.map",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "src/core.ts",
    "src/index.ts",
    "src/wasm.d.ts",
    "src/workers.ts",
    "wasm/tokzip.wasm",
    "FORMAT.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES/"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./src/workers.ts",
      "default": "./dist/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "bench": "bun scripts/bench/bench.ts",
    "build": "bun run build/wasm && build-ts lib --input src/index.ts --module-type esm",
    "build/wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path rust/Cargo.toml -p tokzip-wasm && cp rust/target/wasm32-unknown-unknown/release/tokzip_wasm.wasm wasm/tokzip.wasm",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "release": "wb release",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "train": "bun scripts/train/train.ts",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.4",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "23.0.2",
    "build-ts": "21.0.29",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "lefthook": "2.2.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "25.0.9",
    "wrangler": "4.149.0",
    "zod": "4.6.7"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
