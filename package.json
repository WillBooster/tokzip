{
  "name": "tokzip",
  "version": "0.0.0-semantically-released",
  "description": "Lossless compressor for prompts, LLM outputs, and source code stored at rest: one wasm module, automatic language detection, no options",
  "keywords": [
    "compression",
    "llm",
    "prompt",
    "wasm",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/tokzip.git"
  },
  "license": "UNLICENSED",
  "author": "WillBooster Inc.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./src/workers.ts",
      "default": "./dist/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "wasm/"
  ],
  "scripts": {
    "bench": "bun scripts/bench/bench.ts",
    "build": "bun run build/wasm && build-ts lib --input src/index.ts --module-type esm",
    "build/wasm": "cd rust && cargo build --release --target wasm32-unknown-unknown -p tokzip-wasm && cp target/wasm32-unknown-unknown/release/tokzip_wasm.wasm ../wasm/tokzip.wasm",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "release": "wb release",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "train": "bun scripts/train/train.ts",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.14",
    "@willbooster/oxfmt-config": "1.2.2",
    "@willbooster/oxlint-config": "1.4.8",
    "@willbooster/wb": "22.0.1",
    "build-ts": "21.0.9",
    "conventional-changelog-conventionalcommits": "10.3.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
