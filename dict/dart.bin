Future<void> writeStreamToSink<T>(Stream<T> stream, EventSink<T> sink) {
  final completer = Completer<void>();
  stream.listen(
    sink.add,
    onError: sink.addError,
    onDone: () => completer.complete(),
  );
  return completer.future;
}

