<%
    Context ctx = Context.findContext( pageContext );
    AuthenticationManager mgr = ctx.getEngine().getManager( AuthenticationManager.class );
    String loginURL = "";

    if( mgr.isContainerAuthenticated() ) {
        loginURL = "j_security_check";
    } else {
