<tags11:Echo echo="${'00-hello world'}"/>
<tags11:Echo echo="#{'01-hello world'}"/>
<tags12:Echo echo="${'02-hello world'}"/>
<tags12:Echo echo="#{'03-hello   creationAuthor = firstPage.getAuthor();

    if( creationAuthor != null && !creationAuthor.isEmpty())
    {
      creationAuthor = TextUtil.replaceEntities(creationAuthor);
    }
    else
    {
      creationAuthor = Preferences.getBundle( c, InternationalizationManager.CORE_BUNDLE ).getString( "common.unknownauthor" );
